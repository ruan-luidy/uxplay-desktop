<Application x:Class="UxPlayDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                HandyControl first (it owns the accent), then the app dictionaries one per line and in this order:
                a StaticResource in one of them only sees the dictionaries merged before it.
            -->
            <ResourceDictionary.MergedDictionaries>
                <hc:ThemeResources AccentColor="#3778BF" RequestedTheme="Dark" />
                <hc:Theme />
                <ResourceDictionary Source="/UxPlayDesktop;component/Themes/Tokens.xaml" />
                <ResourceDictionary Source="/UxPlayDesktop;component/Themes/Buttons.xaml" />
                <ResourceDictionary Source="/UxPlayDesktop;component/Themes/Controls.xaml" />
                <ResourceDictionary Source="/UxPlayDesktop;component/Themes/Surfaces.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Older keys still used by pages that have not moved to the new styles yet -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#6E6E6E" />
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Action.Primary}" />
            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Action}" />
            <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceCard}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
