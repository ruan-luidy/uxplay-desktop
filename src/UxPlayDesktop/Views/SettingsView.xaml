<UserControl x:Class="UxPlayDesktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:UxPlayDesktop.Models"
             xmlns:vm="clr-namespace:UxPlayDesktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,10,0,0">

            <!-- General Settings -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[GeneralSettings]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Loc[LanguageLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Loc.SupportedLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              Height="36"
                              Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Flag}" Margin="0,0,6,0" FontSize="14" />
                                    <TextBlock Text="{Binding NativeName}" Foreground="White" FontSize="12" />
                                    <TextBlock Text="{Binding DisplayName, StringFormat=' ({0})'}" Foreground="#888888" FontSize="11" Margin="4,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{Binding Loc[ServerNameLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Settings.ServerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <!-- Monitor Selector -->
                    <TextBlock Text="{Binding Loc[TargetDisplayLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableDisplays}"
                              SelectedItem="{Binding SelectedDisplay}"
                              DisplayMemberPath="DisplayLabel"
                              Margin="0,0,0,12" />

                    <!-- Checkboxes -->
                    <CheckBox Content="{Binding Loc[StartWithWindowsLabel]}" IsChecked="{Binding StartOnBoot}" Margin="0,0,0,6" />
                    <CheckBox Content="{Binding Loc[StartMinimizedLabel]}" IsChecked="{Binding StartMinimized}" Margin="20,0,0,8" />
                    <CheckBox Content="{Binding Loc[MinimizeToTrayLabel]}" IsChecked="{Binding Settings.MinimizeToTray}" Margin="0,0,0,8" />
                    <CheckBox Content="{Binding Loc[AlwaysOnTopLabel]}" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,8" />
                    <CheckBox Content="{Binding Loc[HotkeysLabel]}" IsChecked="{Binding EnableGlobalHotkeys}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Loc[HotkeysHelp]}" FontSize="11" Foreground="#94A3B8" Margin="24,2,0,8" TextWrapping="Wrap" />
                    <CheckBox Content="{Binding Loc[AutoStartServerLabel]}" IsChecked="{Binding Settings.AutoStartServer}" Margin="0,0,0,8" />
                    <CheckBox Content="{Binding Loc[InhibitSleepLabel]}" IsChecked="{Binding Settings.InhibitSleepAndScreensaver}" Margin="0,0,0,8" />
                    <CheckBox Content="{Binding Loc[EnableBleLabel]}" IsChecked="{Binding Settings.EnableBluetoothBeacon}" Margin="0,0,0,4" />
                </StackPanel>
            </Border>

            <!-- Personalization & Accent Theme Colors -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[AccentColorLabel]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Command="{Binding SetAccentColorCommand}" CommandParameter="#38BDF8" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="#38BDF8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding SetAccentColorCommand}" CommandParameter="#A855F7" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="#A855F7">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding SetAccentColorCommand}" CommandParameter="#22C55E" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="#22C55E">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding SetAccentColorCommand}" CommandParameter="#F59E0B" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="#F59E0B">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding SetAccentColorCommand}" CommandParameter="#F43F5E" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="#F43F5E">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Folder Locations & Actions -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding OpenRecordingsFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂 " />
                                <TextBlock Text="{Binding Loc[OpenRecordings]}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding CaptureScreenshotCommand}" Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📸 " />
                                <TextBlock Text="{Binding Loc[ScreenshotButton]}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Video Settings -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[DisplayVideoSettings]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Loc[TargetWidthLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.DisplayWidth}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Loc[TargetHeightLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.DisplayHeight}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Loc[FramerateLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.TargetFps}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Loc[VideoSinkLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.VideoSink}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="{Binding Loc[EnableH265Label]}" IsChecked="{Binding Settings.EnableH265}" Margin="0,0,0,8" />
                    <CheckBox Content="{Binding Loc[ForceFullscreenLabel]}" IsChecked="{Binding Settings.ForceFullscreen}" Margin="0,0,0,8" />
                    <CheckBox Content="{Binding Loc[BorderlessLabel]}" IsChecked="{Binding Settings.BorderlessWindow}" Margin="0,0,0,4" />
                </StackPanel>
            </Border>

            <!-- Audio Settings -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[AudioSettings]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                    <CheckBox Content="{Binding Loc[EnableAudioLabel]}" IsChecked="{Binding Settings.EnableAudio}" Margin="0,0,0,10" />

                    <!-- Audio Volume Slider -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Loc[VolumeLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding VolumeDisplay, StringFormat=': {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="4,0,0,0" />
                            </StackPanel>
                            <Slider Value="{Binding AudioVolume}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ToggleMuteCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Bottom" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IsMuted, Converter={x:Static models:BoolToMuteIconConverter.Instance}}" Margin="0,0,6,0" FontSize="13" />
                                <TextBlock Text="{Binding MuteButtonText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Loc[AudioDelayLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Settings.AudioDelayMs}" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Loc[AudioSinkLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Settings.AudioSink}" Margin="0,0,0,4" />
                </StackPanel>
            </Border>

            <!-- Security & Pairing -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[SecuritySettings]}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                    <CheckBox Content="{Binding Loc[RequirePinLabel]}" IsChecked="{Binding Settings.RequirePin}" Margin="0,0,0,10" />

                    <TextBlock Text="{Binding Loc[FixedPinLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Settings.FixedPin}" MaxLength="4" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Loc[PasswordLabel]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Settings.Password}" Margin="0,0,0,4" />
                </StackPanel>
            </Border>

            <!-- Save Settings Button -->
            <Button Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="{Binding Loc[SaveSettings]}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,24" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
