<UserControl x:Class="UxPlayDesktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:icons="clr-namespace:UxPlayDesktop.Icons"
             xmlns:vm="clr-namespace:UxPlayDesktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">

    <!--
        One card per section, one row per option: the title (and what it does) on the left and the control
        on the right. Switches replace check boxes; text fields are short and sized to what they hold.
    -->
    <UserControl.Resources>
        <Style x:Key="RowSwitch" TargetType="ToggleButton" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
        <Style x:Key="RowField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="Width" Value="220" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
        <Style x:Key="RowNumber" TargetType="TextBox" BasedOn="{StaticResource RowField}">
            <Setter Property="Width" Value="80" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="220" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel Margin="0,0,0,4" DockPanel.Dock="Top">
            <Button VerticalAlignment="Center"
                    hc:IconElement.Geometry="{icons:Phosphor FloppyDiskBold}"
                    Command="{Binding SaveSettingsCommand}"
                    Content="{Binding Loc[SaveSettings]}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Action.Primary}" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="{Binding Loc[TabSettings]}" />
        </DockPanel>

        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel Margin="0,0,16,16">

                <!-- General -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Loc[GeneralSettings]}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ComboBox ItemsSource="{Binding Loc.SupportedLanguages}" SelectedItem="{Binding SelectedLanguage}" Style="{StaticResource RowCombo}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding NativeName, Mode=OneWay}" /><Run Foreground="{DynamicResource MutedTextBrush}" Text="{Binding DisplayName, Mode=OneWay, StringFormat='  {0}'}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[LanguageLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox Style="{StaticResource RowField}" Text="{Binding Settings.ServerName, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[ServerNameLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ComboBox DisplayMemberPath="DisplayLabel" ItemsSource="{Binding AvailableDisplays}" SelectedItem="{Binding SelectedDisplay}" Style="{StaticResource RowCombo}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[TargetDisplayLabel]}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Startup and window behaviour -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Loc[StartupSettings]}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding StartOnBoot}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[StartWithWindowsLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding StartMinimized}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[StartMinimizedLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding Settings.MinimizeToTray}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[MinimizeToTrayLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding AlwaysOnTop}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[AlwaysOnTopLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding Settings.AutoStartServer}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[AutoStartServerLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding Settings.InhibitSleepAndScreensaver}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[InhibitSleepLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding EnableGlobalHotkeys}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[HotkeysLabel]}" />
                                <TextBlock Style="{StaticResource SettingCaption}" Text="{Binding Loc[HotkeysHelp]}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Loc[AppearanceSettings]}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <Border VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="Theme" IsChecked="{Binding IsDarkTheme}" Style="{StaticResource SegmentRadio}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Margin="0,0,6,0" Data="{icons:Phosphor MoonBold}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" />
                                            <TextBlock Text="{Binding Loc[ThemeDark]}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="Theme" IsChecked="{Binding IsLightTheme}" Style="{StaticResource SegmentRadio}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Margin="0,0,6,0" Data="{icons:Phosphor SunBold}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" />
                                            <TextBlock Text="{Binding Loc[ThemeLight]}" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[ThemeLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ListBox VerticalAlignment="Center"
                                     DockPanel.Dock="Right"
                                     ItemsSource="{Binding AvailableAccentColors}"
                                     SelectedItem="{Binding AccentColor}"
                                     Style="{StaticResource ColorSwatches}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[AccentColorLabel]}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Display and video -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Loc[DisplayVideoSettings]}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox Style="{StaticResource RowNumber}" Text="{Binding Settings.DisplayWidth}" ToolTip="{Binding Loc[TargetWidthLabel]}" />
                                <TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="×" />
                                <TextBox Style="{StaticResource RowNumber}" Text="{Binding Settings.DisplayHeight}" ToolTip="{Binding Loc[TargetHeightLabel]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[ResolutionLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox Style="{StaticResource RowNumber}" Text="{Binding Settings.TargetFps}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[FramerateLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox Style="{StaticResource RowField}" Text="{Binding Settings.VideoSink}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[VideoSinkLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding Settings.EnableH265}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[EnableH265Label]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding Settings.ForceFullscreen}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[ForceFullscreenLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding Settings.BorderlessWindow}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[BorderlessLabel]}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Audio -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Loc[AudioSettings]}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding Settings.EnableAudio}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[EnableAudioLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Width="56" Margin="0,0,12,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding VolumeDisplay}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <Slider Width="200" Margin="0,0,12,0" VerticalAlignment="Center" Maximum="1" Minimum="0" Value="{Binding AudioVolume}" />
                                <ToggleButton hc:IconElement.Geometry="{icons:Phosphor SpeakerHighBold}"
                                              hc:IconSwitchElement.GeometrySelected="{icons:Phosphor SpeakerSlashBold}"
                                              IsChecked="{Binding IsMuted}"
                                              Style="{StaticResource Action.Toggle.Icon}"
                                              ToolTip="{Binding MuteButtonText}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[VolumeLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox Style="{StaticResource RowNumber}" Text="{Binding Settings.AudioDelayMs}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[AudioDelayLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox Style="{StaticResource RowField}" Text="{Binding Settings.AudioSink}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[AudioSinkLabel]}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Security and pairing -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Loc[SecuritySettings]}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ToggleButton IsChecked="{Binding Settings.RequirePin}" Style="{StaticResource RowSwitch}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[RequirePinLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox MaxLength="4" Style="{StaticResource RowNumber}" Text="{Binding Settings.FixedPin}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[FixedPinLabel]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox Style="{StaticResource RowField}" Text="{Binding Settings.Password}" />
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[PasswordLabel]}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Discovery -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Loc[BonjourTitle]}" />
                <Border Style="{StaticResource SettingGroup}">
                    <DockPanel Style="{StaticResource SettingRow}">
                        <ToggleButton IsChecked="{Binding Settings.EnableBluetoothBeacon}" Style="{StaticResource RowSwitch}" />
                        <StackPanel Style="{StaticResource SettingText}">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[EnableBleLabel]}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
