<UserControl x:Class="UxPlayDesktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:UxPlayDesktop.Models"
             xmlns:vm="clr-namespace:UxPlayDesktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Logs Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding Logs.FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding Loc[LogsFilterTooltip]}"
                     Height="34"
                     Margin="0,0,10,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox IsChecked="{Binding Logs.AutoScroll}"
                          Content="{Binding Loc[LogsAutoScroll]}"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0" />
                <Button Command="{Binding Logs.CopyCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="{Binding Loc[LogsCopy]}"
                        Margin="0,0,6,0" />
                <Button Command="{Binding Logs.ClearCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="{Binding Loc[LogsClear]}" />
            </StackPanel>
        </Grid>

        <!-- Logs List -->
        <Border Grid.Row="1" Background="#111111" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
            <Grid>
                <TextBlock Text="{Binding Loc[LogsWaitingPlaceholder]}"
                           Foreground="#666666"
                           FontStyle="Italic"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding Logs.HasLogs, Converter={x:Static models:InverseBoolToVisibilityConverter.Instance}}" />

                <ListView x:Name="LogsListView"
                           ItemsSource="{Binding Logs.FilteredLogs}"
                           Background="Transparent"
                           BorderThickness="0"
                           Foreground="White"
                           FontFamily="Consolas, Cascadia Code, Courier New"
                           FontSize="12">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" Foreground="#777777" />
                                <Border Grid.Column="1" Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
