<UserControl x:Class="UxPlayDesktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:UxPlayDesktop.Controls"
             xmlns:icons="clr-namespace:UxPlayDesktop.Icons"
             xmlns:models="clr-namespace:UxPlayDesktop.Models"
             xmlns:vm="clr-namespace:UxPlayDesktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="LogRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="{StaticResource Radius.Md}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock Margin="0,0,0,16" DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{Binding Loc[TabLogs]}" />

        <!-- One strip: search, the level filter with its counts, and the actions on the right -->
        <DockPanel Margin="0,0,0,12" DockPanel.Dock="Top">
            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton Margin="16,0,8,0" VerticalAlignment="Center" IsChecked="{Binding Logs.AutoScroll}" Style="{StaticResource Switch}" />
                <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Loc[LogsAutoScroll]}" />
                <Button Margin="0,0,8,0" hc:IconElement.Geometry="{icons:Phosphor CopyBold}" Command="{Binding Logs.CopyCommand}" Style="{StaticResource Action.Icon}" ToolTip="{Binding Loc[LogsCopy]}" />
                <Button hc:IconElement.Geometry="{icons:Phosphor TrashBold}" Command="{Binding Logs.ClearCommand}" Style="{StaticResource Action.Icon}" ToolTip="{Binding Loc[LogsClear]}" />
            </StackPanel>

            <hc:TextBox Width="280"
                        Margin="0,0,12,0"
                        hc:InfoElement.Placeholder="{Binding Loc[LogsFilterTooltip]}"
                        Style="{StaticResource SearchField}"
                        Text="{Binding Logs.FilterText, UpdateSourceTrigger=PropertyChanged}" />

            <Border HorizontalAlignment="Left" Style="{StaticResource SegmentGroup}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{Binding Loc[LogsFilterAll]}" IsChecked="{Binding Logs.IsAllLevels}" Style="{StaticResource SegmentRadio}" />
                    <RadioButton IsChecked="{Binding Logs.SelectedLevelFilter, Converter={x:Static models:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static models:LogLevel.Warning}}" Style="{StaticResource SegmentRadio}">
                        <TextBlock><Run Text="{Binding Loc[LogsFilterWarnings], Mode=OneWay}" /><Run Typography.NumeralAlignment="Tabular" Text="{Binding Logs.WarningCount, Mode=OneWay, StringFormat='  {0}'}" /></TextBlock>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding Logs.SelectedLevelFilter, Converter={x:Static models:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static models:LogLevel.Error}}" Style="{StaticResource SegmentRadio}">
                        <TextBlock><Run Text="{Binding Loc[LogsFilterErrors], Mode=OneWay}" /><Run Typography.NumeralAlignment="Tabular" Text="{Binding Logs.ErrorCount, Mode=OneWay, StringFormat='  {0}'}" /></TextBlock>
                    </RadioButton>
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Padding="6" Background="{DynamicResource Card.BackgroundBrush}" CornerRadius="{StaticResource Radius.Card}">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Logs.HasLogs, Converter={x:Static models:InverseBoolToVisibilityConverter.Instance}}">
                    <Path Width="32" Height="32" Data="{icons:Phosphor TerminalWindowBold}" Fill="{DynamicResource MutedTextBrush}" Stretch="Uniform" />
                    <TextBlock MaxWidth="360"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding Loc[LogsWaitingPlaceholder]}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListBox x:Name="LogsListView"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource LogRow}"
                         ItemsSource="{Binding Logs.FilteredLogs}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Visibility="{Binding Logs.HasLogs, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LogEntry}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Top"
                                           Margin="0,2,0,0"
                                           Typography.NumeralAlignment="Tabular"
                                           FontSize="{StaticResource FontSize.Sm}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding FormattedTime}" />
                                <controls:Chip Grid.Column="1" VerticalAlignment="Top" Content="{Binding Level}" Tone="{Binding Tone}" />
                                <TextBlock Grid.Column="2"
                                           Margin="0,2,0,0"
                                           FontFamily="{StaticResource FontFamily.Mono}"
                                           FontSize="{StaticResource FontSize.Sm}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
