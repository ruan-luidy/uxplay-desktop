<UserControl x:Class="UxPlayDesktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:UxPlayDesktop.Controls"
             xmlns:icons="clr-namespace:UxPlayDesktop.Icons"
             xmlns:models="clr-namespace:UxPlayDesktop.Models"
             xmlns:vm="clr-namespace:UxPlayDesktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- The status card: a soft wash of the status colour coming in from the left -->
        <Style x:Key="StatusWash" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
            <Setter Property="Background" Value="{DynamicResource Neutral.SoftBrush}" />
            <Setter Property="OpacityMask">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Black" />
                        <GradientStop Offset="0.6" Color="Transparent" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static models:Tone.Accent}">
                    <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static models:Tone.Success}">
                    <Setter Property="Background" Value="{DynamicResource Success.SoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static models:Tone.Warning}">
                    <Setter Property="Background" Value="{DynamicResource Warning.SoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static models:Tone.Danger}">
                    <Setter Property="Background" Value="{DynamicResource Danger.SoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTile" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Neutral.SoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static models:Tone.Accent}">
                    <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static models:Tone.Success}">
                    <Setter Property="Background" Value="{DynamicResource Success.SoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static models:Tone.Warning}">
                    <Setter Property="Background" Value="{DynamicResource Warning.SoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static models:Tone.Danger}">
                    <Setter Property="Background" Value="{DynamicResource Danger.SoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusIcon" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Data" Value="{icons:Phosphor PowerBold}" />
            <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ServerState}" Value="{x:Static models:ServerState.Listening}">
                    <Setter Property="Data" Value="{icons:Phosphor BroadcastBold}" />
                    <Setter Property="Fill" Value="{DynamicResource Accent.TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ServerState}" Value="{x:Static models:ServerState.Streaming}">
                    <Setter Property="Data" Value="{icons:Phosphor ScreencastFill}" />
                    <Setter Property="Fill" Value="{DynamicResource Success.TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ServerState}" Value="{x:Static models:ServerState.Error}">
                    <Setter Property="Data" Value="{icons:Phosphor WarningCircleFill}" />
                    <Setter Property="Fill" Value="{DynamicResource Danger.TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatIcon" TargetType="Path" BasedOn="{StaticResource IconTileGlyph}" />

        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent.TextBrush}" />
            <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Sm}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="0,0,16,8">

            <!-- Header: the name Apple devices see, the address they reach, and the quick actions -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            hc:IconElement.Geometry="{icons:Phosphor CameraBold}"
                            Command="{Binding CaptureScreenshotCommand}"
                            Style="{StaticResource Action.Icon}"
                            ToolTip="{Binding Loc[ScreenshotButton]}" />
                    <Button Margin="0,0,8,0"
                            hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                            Command="{Binding OpenRecordingsFolderCommand}"
                            Style="{StaticResource Action.Icon}"
                            ToolTip="{Binding Loc[OpenRecordings]}" />
                    <Button Margin="0,0,8,0"
                            hc:IconElement.Geometry="{icons:Phosphor PictureInPictureBold}"
                            Command="{Binding ToggleCompactModeCommand}"
                            Style="{StaticResource Action.Icon}"
                            ToolTip="{Binding Loc[CompactModeLabel]}" />
                    <Button hc:IconElement.Geometry="{icons:Phosphor RecordBold}"
                            Command="{Binding ToggleRecordingCommand}"
                            Content="{Binding Loc[RecordButton]}"
                            Style="{StaticResource Action}"
                            ToolTip="{Binding Loc[RecordingTitle]}"
                            Visibility="{Binding IsRecording, Converter={x:Static models:InverseBoolToVisibilityConverter.Instance}}" />
                    <Button hc:IconElement.Geometry="{icons:Phosphor StopFill}"
                            Background="{DynamicResource Danger.SoftBrush}"
                            Command="{Binding ToggleRecordingCommand}"
                            Content="{Binding Loc[StopRecordButton]}"
                            Foreground="{DynamicResource Danger.TextBrush}"
                            Style="{StaticResource Action}"
                            ToolTip="{Binding Loc[RecordingTitle]}"
                            Visibility="{Binding IsRecording, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Settings.ServerName}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}">
                        <Run Text="{Binding Loc[LocalIpLabel], Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding LocalNetworkInfo, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Update available -->
            <Border Margin="0,0,0,12"
                    Style="{StaticResource InfoBanner}"
                    Visibility="{Binding IsUpdateAvailable, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}">
                <Grid>
                    <DockPanel Visibility="{Binding IsUpdating, Converter={x:Static models:InverseBoolToVisibilityConverter.Instance}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Margin="0,0,8,0" Command="{Binding DismissUpdateCommand}" Content="{Binding Loc[UpdateLater]}" Style="{StaticResource Action}" />
                            <Button hc:IconElement.Geometry="{icons:Phosphor DownloadSimpleBold}" Command="{Binding ApplyUpdateCommand}" Content="{Binding Loc[UpdateNow]}" Style="{StaticResource Action.Primary}" />
                        </StackPanel>
                        <Path Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Data="{icons:Phosphor ArrowCircleUpFill}" DockPanel.Dock="Left" Fill="{DynamicResource Accent.TextBrush}" Stretch="Uniform" />
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}">
                                <Run Text="{Binding Loc[UpdateAvailableTitle], Mode=OneWay}" /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding UpdateVersionText, Mode=OneWay, StringFormat='  {0}'}" />
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding Loc[UpdateAvailableDesc]}" TextTrimming="None" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Visibility="{Binding IsUpdating, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Accent.TextBrush}" Text="{Binding UpdateProgress, StringFormat='{}{0}%'}" />
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}">
                                <Run Text="{Binding Loc[DownloadingUpdate], Mode=OneWay}" /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Loc[PleaseWait], Mode=OneWay, StringFormat='  {0}'}" />
                            </TextBlock>
                        </DockPanel>
                        <ProgressBar Margin="0,10,0,0" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pairing PIN requested by the Apple device -->
            <Border Margin="0,0,0,12"
                    Style="{StaticResource WarningBanner}"
                    Visibility="{Binding ActivePinCode, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding DismissPinCommand}" Content="{Binding Loc[PinDismiss]}" Style="{StaticResource Action}" />
                    <Path Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Data="{icons:Phosphor LockKeyFill}" DockPanel.Dock="Left" Fill="{DynamicResource Warning.TextBrush}" Stretch="Uniform" />
                    <TextBlock Margin="16,0,24,0" VerticalAlignment="Center" DockPanel.Dock="Right" FontSize="{StaticResource FontSize.Display}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding ActivePinCode}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Loc[PinRequestedTitle]}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding Loc[PinRequestedDesc]}" TextTrimming="None" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Server status and the main action -->
            <Grid>
                <Border Background="{DynamicResource Card.BackgroundBrush}" CornerRadius="{StaticResource Radius.Card}" />
                <Border Style="{StaticResource StatusWash}" />
                <DockPanel Margin="18,16">
                    <Grid MinWidth="200" VerticalAlignment="Center" DockPanel.Dock="Right">
                        <Button HorizontalAlignment="Stretch"
                                hc:IconElement.Geometry="{icons:Phosphor PlayFill}"
                                Command="{Binding ToggleServerCommand}"
                                Content="{Binding Loc[StartServer]}"
                                Style="{StaticResource Action.Primary}"
                                Visibility="{Binding IsServerRunning, Converter={x:Static models:InverseBoolToVisibilityConverter.Instance}}" />
                        <Button HorizontalAlignment="Stretch"
                                hc:IconElement.Geometry="{icons:Phosphor StopFill}"
                                Command="{Binding ToggleServerCommand}"
                                Content="{Binding Loc[StopServer]}"
                                Style="{StaticResource Action}"
                                Visibility="{Binding IsServerRunning, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}" />
                    </Grid>

                    <Border Margin="0,0,16,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource StatusTile}">
                        <Grid>
                            <Path Style="{StaticResource StatusIcon}" />
                            <hc:CircleProgressBar Width="22"
                                                  Height="22"
                                                  ArcThickness="2"
                                                  IsIndeterminate="True"
                                                  ShowText="False"
                                                  Visibility="{Binding IsBusy, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}" />
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource FontSize.Lg}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding StatusTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="{Binding StatusDescription}" TextTrimming="None" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Live numbers -->
            <UniformGrid Margin="0,12,-10,0" Columns="4" Rows="1">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                <Path Data="{icons:Phosphor DeviceTabletSpeakerBold}" Style="{StaticResource StatIcon}" />
                            </Border>
                            <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Loc[ConnectedDevice]}" />
                        </DockPanel>
                        <TextBlock FontFamily="{StaticResource FontFamily.Default}" FontSize="{StaticResource FontSize.Lg}" Style="{StaticResource StatValue}" Text="{Binding DisplayClientName}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding DisplayClientIp}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                <Path Data="{icons:Phosphor MonitorBold}" Style="{StaticResource StatIcon}" />
                            </Border>
                            <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Loc[Resolution]}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding Session.ActiveResolution}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Loc[HardwareAccelerated]}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                <Path Data="{icons:Phosphor FilmStripBold}" Style="{StaticResource StatIcon}" />
                            </Border>
                            <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Loc[VideoLabel]}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding Session.ActiveCodec}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding DisplayTargetFps}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                <Path Data="{icons:Phosphor TimerBold}" Style="{StaticResource StatIcon}" />
                            </Border>
                            <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Loc[StreamTime]}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding FormattedDuration}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding SessionActiveText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- How to connect, while nothing is mirroring -->
            <StackPanel Visibility="{Binding IsStreaming, Converter={x:Static models:InverseBoolToVisibilityConverter.Instance}}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Loc[AirPlayGuideTitle]}" />
                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource InfoRow}">
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Loc[Step1Desc]}" TextWrapping="Wrap" />
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource InfoRow}">
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="2" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Loc[Step2Desc]}" TextWrapping="Wrap" />
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource InfoRow}">
                            <Border Style="{StaticResource StepNumber}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="3" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding DisplayStep3Desc}" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Playback: the streaming profile and the volume -->
            <Border Margin="0,20,0,0" Style="{StaticResource SettingGroup}">
                <StackPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <ComboBox Width="320"
                                  ItemsSource="{Binding PresetOptions}"
                                  SelectedItem="{Binding SelectedPresetOption}"
                                  DockPanel.Dock="Right"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Style="{StaticResource SettingText}">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[PresetTitle]}" />
                            <TextBlock Style="{StaticResource SettingCaption}" Text="{Binding PresetDescription}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource InfoDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Width="56" Margin="0,0,12,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding VolumeDisplay}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                            <Slider Width="200" Margin="0,0,12,0" VerticalAlignment="Center" Maximum="1" Minimum="0" Value="{Binding AudioVolume}" />
                            <ToggleButton hc:IconElement.Geometry="{icons:Phosphor SpeakerHighBold}"
                                          hc:IconSwitchElement.GeometrySelected="{icons:Phosphor SpeakerSlashBold}"
                                          IsChecked="{Binding IsMuted}"
                                          Style="{StaticResource Action.Toggle.Icon}"
                                          ToolTip="{Binding MuteButtonText}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource SettingText}">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[VolumeLabel]}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Discovery on the local network -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Loc[BonjourTitle]}" />
            <Border Style="{StaticResource SettingGroup}">
                <StackPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Chip Margin="0,0,12,0" Content="{Binding BonjourStatusText}" Tone="{Binding BonjourTone}" />
                            <Button hc:IconElement.Geometry="{icons:Phosphor WrenchBold}" Command="{Binding FixBonjourCommand}" Content="{Binding Loc[RepairBonjour]}" Style="{StaticResource Action}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource SettingText}">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Bonjour (mDNS)" />
                            <TextBlock Style="{StaticResource SettingCaption}" Text="{Binding Loc[BonjourDesc]}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource InfoDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Button VerticalAlignment="Center" hc:IconElement.Geometry="{icons:Phosphor StethoscopeBold}" Command="{Binding RunDiagnosticCommand}" Content="{Binding Loc[DiagnosticButton]}" DockPanel.Dock="Right" Style="{StaticResource Action}" />
                        <StackPanel Style="{StaticResource SettingText}">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Loc[DiagnosticTitle]}" />
                            <TextBlock Style="{StaticResource SettingCaption}" Text="{Binding Loc[DiagnosticSubtitle]}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
