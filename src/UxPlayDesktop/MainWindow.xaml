<hc:Window x:Class="UxPlayDesktop.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:controls="clr-namespace:UxPlayDesktop.Controls"
           xmlns:icons="clr-namespace:UxPlayDesktop.Icons"
           xmlns:models="clr-namespace:UxPlayDesktop.Models"
           xmlns:services="clr-namespace:UxPlayDesktop.Services"
           xmlns:views="clr-namespace:UxPlayDesktop.Views"
           xmlns:vm="clr-namespace:UxPlayDesktop.ViewModels"
           d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
           mc:Ignorable="d"
           Title="UxPlay Desktop"
           Icon="resources/newicon.ico"
           Height="{Binding WindowHeight, Mode=TwoWay}" Width="{Binding WindowWidth, Mode=TwoWay}"
           MinHeight="{Binding WindowMinHeight, Mode=OneWay}" MinWidth="{Binding WindowMinWidth, Mode=OneWay}"
           BorderBrush="{DynamicResource BorderBrush}"
           NonClientAreaBackground="Transparent"
           ShowTitle="True"
           WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Full window: the side pane on the window backdrop and the open page on a layer over it -->
        <Grid Visibility="{Binding IsCompactMode, Converter={x:Static models:InverseBoolToVisibilityConverter.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="8,4,8,8">
                <Border Margin="0,6,0,0" Padding="0,6,0,0" BorderBrush="{DynamicResource Divider.Brush}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom">
                    <StackPanel>
                        <RadioButton Content="{Binding Loc[TabSettings]}"
                                     IsChecked="{Binding SelectedPage, Converter={x:Static models:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Settings}}"
                                     Style="{StaticResource SideNavItem}"
                                     Tag="{icons:Phosphor GearSixBold}" />
                        <RadioButton Content="{Binding Loc[TabAbout]}"
                                     IsChecked="{Binding SelectedPage, Converter={x:Static models:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:AppPage.About}}"
                                     Style="{StaticResource SideNavItem}"
                                     Tag="{icons:Phosphor InfoBold}" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Content="{Binding Loc[TabDashboard]}"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static models:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Dashboard}}"
                                 Style="{StaticResource SideNavItem}"
                                 Tag="{icons:Phosphor ScreencastBold}" />
                    <RadioButton Content="{Binding Loc[TabLogs]}"
                                 IsChecked="{Binding SelectedPage, Converter={x:Static models:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Logs}}"
                                 Style="{StaticResource SideNavItem}"
                                 Tag="{icons:Phosphor TerminalWindowBold}" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource Pane.BackgroundBrush}" CornerRadius="12,0,0,0">
                <Grid Margin="{StaticResource Page.Margin}">
                    <views:DashboardView Visibility="{Binding SelectedPage, Converter={x:Static models:EnumToVisibilityConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Dashboard}}" />
                    <views:LogsView Visibility="{Binding SelectedPage, Converter={x:Static models:EnumToVisibilityConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Logs}}" />
                    <views:SettingsView Visibility="{Binding SelectedPage, Converter={x:Static models:EnumToVisibilityConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Settings}}" />
                    <views:AboutView Visibility="{Binding SelectedPage, Converter={x:Static models:EnumToVisibilityConverter.Instance}, ConverterParameter={x:Static vm:AppPage.About}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Mini widget -->
        <views:CompactView Visibility="{Binding IsCompactMode, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}" />

        <!-- Notices (screenshot saved, settings saved, Bonjour repair...): a toast at the top of the page -->
        <Grid Width="440"
              Margin="200,12,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Panel.ZIndex="900"
              RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Grid.Resources>
                <Style x:Key="ToastDisc" TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Success.SoftBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastTone}" Value="{x:Static models:Tone.Warning}">
                            <Setter Property="Background" Value="{DynamicResource Warning.SoftBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastTone}" Value="{x:Static models:Tone.Danger}">
                            <Setter Property="Background" Value="{DynamicResource Danger.SoftBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastTone}" Value="{x:Static models:Tone.Accent}">
                            <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="ToastIcon" TargetType="Path">
                    <Setter Property="Data" Value="{icons:Phosphor CheckCircleFill}" />
                    <Setter Property="Fill" Value="{DynamicResource Success.TextBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastTone}" Value="{x:Static models:Tone.Warning}">
                            <Setter Property="Data" Value="{icons:Phosphor WarningFill}" />
                            <Setter Property="Fill" Value="{DynamicResource Warning.TextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastTone}" Value="{x:Static models:Tone.Danger}">
                            <Setter Property="Data" Value="{icons:Phosphor XCircleFill}" />
                            <Setter Property="Fill" Value="{DynamicResource Danger.TextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastTone}" Value="{x:Static models:Tone.Accent}">
                            <Setter Property="Data" Value="{icons:Phosphor InfoFill}" />
                            <Setter Property="Fill" Value="{DynamicResource Accent.TextBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-24" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource ToastShadow}" />
            <Border Padding="14,12,10,12" Style="{StaticResource ToastCard}">
                <DockPanel>
                    <Button Margin="8,0,0,0"
                            VerticalAlignment="Top"
                            hc:IconElement.Geometry="{icons:Phosphor XBold}"
                            hc:IconElement.Height="10"
                            hc:IconElement.Width="10"
                            Command="{Binding DismissToastCommand}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Action.Icon.Small}"
                            ToolTip="{Binding Loc[Close]}" />
                    <Border Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top" CornerRadius="17" DockPanel.Dock="Left" Style="{StaticResource ToastDisc}">
                        <Path Width="16" Height="16" Stretch="Uniform" Style="{StaticResource ToastIcon}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding ToastTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding ToastMessage}"
                                   TextTrimming="None"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ToastMessage, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Network doctor: a dialog over a dimmed window -->
        <Grid Panel.ZIndex="1000" Visibility="{Binding ShowDiagnosticDialog, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}">
            <Border Background="{DynamicResource Overlay.ScrimBrush}" />
            <Grid Width="580" MaxHeight="560" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource DialogShadow}" />
                <Border Style="{StaticResource DialogCard}">
                    <DockPanel>
                        <DockPanel Margin="24,20,16,12" DockPanel.Dock="Top">
                            <Button VerticalAlignment="Top"
                                    hc:IconElement.Geometry="{icons:Phosphor XBold}"
                                    Command="{Binding CloseDiagnosticCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Action.Icon.Close}"
                                    ToolTip="{Binding Loc[Close]}" />
                            <Border Margin="0,0,14,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource DialogIconTile}">
                                <Path Width="18" Height="18" Data="{icons:Phosphor StethoscopeBold}" Fill="{DynamicResource Accent.TextBrush}" Stretch="Uniform" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="{StaticResource FontSize.Lg}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Loc[DiagnosticTitle]}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding Loc[DiagnosticSubtitle]}" TextTrimming="None" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Command="{Binding CloseDiagnosticCommand}" Content="{Binding Loc[Close]}" Style="{StaticResource Action.Dialog}" />
                                <Button hc:IconElement.Geometry="{icons:Phosphor WrenchBold}" Command="{Binding FixBonjourCommand}" Content="{Binding Loc[DiagnosticRepair]}" Style="{StaticResource Action.Dialog.Primary}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="24,0,24,16">
                            <StackPanel Margin="0,24" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="{Binding IsRunningDiagnostic, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}">
                                <hc:CircleProgressBar Width="18" Height="18" Margin="0,0,10,0" ArcThickness="2" IsIndeterminate="True" ShowText="False" />
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Loc[DiagnosticRunning]}" />
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsRunningDiagnostic, Converter={x:Static models:InverseBoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <Border Margin="0,0,0,12" Padding="12,10" CornerRadius="{StaticResource Radius.Lg}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Warning.SoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiagnosticReport.IsHealthy}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Success.SoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DiagnosticReport}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Loc[DiagnosticIssues]}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DiagnosticReport.IsHealthy}" Value="True">
                                                            <Setter Property="Text" Value="{Binding Loc[DiagnosticHealthy]}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <Border Style="{StaticResource InfoCard}">
                                        <ItemsControl ItemsSource="{Binding DiagnosticReport.Results}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type services:DiagnosticItem}">
                                                    <StackPanel>
                                                        <Border x:Name="Divider" Style="{StaticResource InfoDivider}" />
                                                        <DockPanel Margin="0,12">
                                                            <Path x:Name="Icon"
                                                                  Width="16"
                                                                  Height="16"
                                                                  Margin="0,1,12,0"
                                                                  VerticalAlignment="Top"
                                                                  Data="{icons:Phosphor CheckCircleFill}"
                                                                  DockPanel.Dock="Left"
                                                                  Fill="{DynamicResource Success.TextBrush}"
                                                                  Stretch="Uniform" />
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Title}" />
                                                                    <controls:Chip Margin="8,0,0,0" Content="{Binding Category}" />
                                                                </StackPanel>
                                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{Binding Message}" TextTrimming="None" TextWrapping="Wrap" />
                                                                <DockPanel Margin="0,6,0,0" Visibility="{Binding Recommendation, Converter={x:Static models:ObjectToVisibilityConverter.Instance}}">
                                                                    <Path Width="13" Height="13" Margin="0,1,6,0" VerticalAlignment="Top" Data="{icons:Phosphor LightbulbBold}" DockPanel.Dock="Left" Fill="{DynamicResource Warning.TextBrush}" Stretch="Uniform" />
                                                                    <TextBlock FontSize="{StaticResource FontSize.Sm}" Foreground="{DynamicResource Warning.TextBrush}" Text="{Binding Recommendation}" TextWrapping="Wrap" />
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                            <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static services:DiagnosticSeverity.Warning}">
                                                            <Setter TargetName="Icon" Property="Data" Value="{icons:Phosphor WarningFill}" />
                                                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Warning.TextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static services:DiagnosticSeverity.Fail}">
                                                            <Setter TargetName="Icon" Property="Data" Value="{icons:Phosphor XCircleFill}" />
                                                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Danger.TextBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</hc:Window>
