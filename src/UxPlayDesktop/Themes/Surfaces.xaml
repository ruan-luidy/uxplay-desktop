<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:UxPlayDesktop.Controls">

    <!--
        Surfaces. Nothing on a page has a hard outline: the page is a translucent layer over the window
        backdrop, cards are one more layer on top, and rows inside a card are split by a faint divider.
        Only what floats (tooltips, menus, dialogs, toasts) gets a border.
    -->

    <!-- Text -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,20,0,8" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,10,0,2" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Cards -->
    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    </Style>

    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- Small square behind an icon: soft accent background, accent icon -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
    </Style>

    <Style x:Key="IconTileGlyph" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Fill" Value="{DynamicResource Accent.TextBrush}" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- Information card: "label ..... value [action]" rows split by a thin divider -->
    <Style x:Key="InfoCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="16,2" />
    </Style>

    <Style x:Key="InfoRow" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="LastChildFill" Value="True" />
    </Style>

    <Style x:Key="InfoLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="InfoValue" TargetType="TextBlock">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="InfoDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Divider.Brush}" />
    </Style>

    <!--
        Settings: one card per section (SettingGroup) with the section name above it. Each option is a row
        (SettingRow) with the title and an optional caption on the left and the control on the right.
    -->
    <Style x:Key="SettingGroup" TargetType="Border">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    </Style>

    <Style x:Key="SettingRow" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="LastChildFill" Value="True" />
    </Style>

    <Style x:Key="SettingText" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,10,24,10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingCaption" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The control on the right side of a setting row -->
    <Style x:Key="SettingControl" TargetType="FrameworkElement">
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Status chip -->
    <Style TargetType="controls:Chip">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource Neutral.SoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Chip">
                    <Border Height="20" Padding="8,0" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tone" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Accent.TextBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Success.SoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Success.TextBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Warning.SoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Warning.TextBrush}" />
            </Trigger>
            <Trigger Property="Tone" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Danger.SoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Danger.TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Banners: a soft tinted strip for a message that asks for attention -->
    <Style x:Key="InfoBanner" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    </Style>

    <Style x:Key="WarningBanner" TargetType="Border" BasedOn="{StaticResource InfoBanner}">
        <Setter Property="Background" Value="{DynamicResource Warning.SoftBrush}" />
    </Style>

    <!-- Side navigation item (NavigationView, left mode): icon in Tag, accent bar and fill on the open page -->
    <CubicEase x:Key="Nav.Ease" EasingMode="EaseOut" />

    <Style x:Key="SideNavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="GroupName" Value="Pages" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Item" Height="{StaticResource Nav.ItemHeight}" Padding="12,0" Background="Transparent" CornerRadius="{StaticResource Radius.Md}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Icon"
                                      Width="{StaticResource Icon.Size.Nav}"
                                      Height="{StaticResource Icon.Size.Nav}"
                                      Data="{TemplateBinding Tag}"
                                      Fill="{TemplateBinding Foreground}"
                                      RenderTransformOrigin="0.5,0.5"
                                      Stretch="Uniform">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="IconScale" />
                                    </Path.RenderTransform>
                                </Path>
                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="Bar"
                                Width="3"
                                Height="16"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="2"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation EasingFunction="{StaticResource Nav.Ease}" Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15" />
                                        <DoubleAnimation EasingFunction="{StaticResource Nav.Ease}" Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation EasingFunction="{StaticResource Nav.Ease}" Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation EasingFunction="{StaticResource Nav.Ease}" Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.10" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation EasingFunction="{StaticResource Nav.Ease}" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16" />
                            <DoubleAnimation EasingFunction="{StaticResource Nav.Ease}" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dialog: one card in the flyout grey, title with an icon tile, body, and a darker footer for the buttons -->
    <Style x:Key="DialogShadow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Dialog.BackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.XL}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Dialog}" />
    </Style>

    <Style x:Key="DialogCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Dialog.BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Flyout.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.XL}" />
    </Style>

    <Style x:Key="DialogFooter" TargetType="Border">
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="Background" Value="{DynamicResource Dialog.FooterBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider.Brush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0,0,11,11" />
    </Style>

    <Style x:Key="DialogIconTile" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
    </Style>

    <!-- Toast: the flyout card, a little bigger, with its own shadow -->
    <Style x:Key="ToastShadow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Flyout.BackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.XL}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Toast}" />
    </Style>

    <Style x:Key="ToastCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Flyout.BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Flyout.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.XL}" />
    </Style>

</ResourceDictionary>
