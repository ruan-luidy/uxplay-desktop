<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\resources\newicon.ico</ApplicationIcon>
    <Version>1.2.3</Version>
    <AssemblyVersion>1.2.3.0</AssemblyVersion>
    <FileVersion>1.2.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HandyControls" Version="3.6.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.PhosphorIcons" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\resources\newicon.ico" Link="resources\newicon.ico" />
    <None Include="..\..\resources\newicon.ico" Link="resources\newicon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
